# ==============================================================================
# HieuDaoTao Policy Intelligence Prototype - Environment Configuration
# ==============================================================================

# Active AI Provider: 'vertex' (default) or 'anthropic'
AI_PROVIDER=vertex

# ------------------------------------------------------------------------------
# Vertex AI / Google Gen AI Configuration (Active Provider)
# ------------------------------------------------------------------------------
# Vertex AI Express Mode API Key (or Gemini API Key):
VERTEX_API_KEY=
# Configurable Vertex model ID (default: gemini-2.5-flash):
VERTEX_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Anthropic Claude Configuration (Architecturally Supported / Future Provider)
# ------------------------------------------------------------------------------
# Leave blank while Vertex is active. When AI_PROVIDER=anthropic, both are required:
