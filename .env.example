# ==============================================================================
# HieuDaoTao Policy Intelligence Prototype - Environment Configuration
# ==============================================================================

# Active AI Provider: 'vertex' (default) or 'anthropic'
AI_PROVIDER=vertex

# ------------------------------------------------------------------------------
# Vertex AI / Google Gen AI Configuration (Active Provider)
# ------------------------------------------------------------------------------
# Provide your Vertex AI Express Mode API Key or Gemini API Key:
VERTEX_API_KEY=
# Configurable model ID (default: gemini-2.5-flash)
VERTEX_MODEL=gemini-2.5-flash

# Optional standard Google Cloud project/location fallback:
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=us-central1

# ------------------------------------------------------------------------------
# Anthropic Claude Configuration (Architecturally Supported / Future Provider)
# ------------------------------------------------------------------------------
# Leave blank while Vertex is active. Required only when AI_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
# Configurable Anthropic model ID:
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
